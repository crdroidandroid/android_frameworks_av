package {
    default_applicable_licenses: [
        "frameworks_av_media_libstagefright_tests_license",
    ],
}

cc_test {
    name: "MediaSyncTest",

    srcs: [
        "MediaSyncTest.cpp",
    ],

    header_libs: [
        "libnativewindow_headers",
    ],

    shared_libs: [
        "libbinder",
        "libgui",
        "libstagefright",
        "libutils",
    ],

    static_libs: [
        "libgmock",
        "libgui_mocks",
    ],

    cflags: [
        "-Werror",
    ],

    test_suites: [
        "device-tests",
    ],
}
